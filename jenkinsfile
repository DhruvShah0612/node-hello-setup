pipeline {
agent any

```
stages {
    stage('Checkout') {
        steps {
            git branch: 'master',
                credentialsId: 'github-private',
                url: 'https://github.com/DhruvShah0612/node-hello-setup.git'
        }
    }

    stage('Deploy to EC2') {
        steps {
            withCredentials([
                sshUserPrivateKey(
                    credentialsId: 'ec2-ssh',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USER'
                )
            ]) {
                sh '''
                    echo "Creating application directory..."

                    ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no \
                        ${SSH_USER}@13.234.74.131 \
                        "mkdir -p /var/www/html/node-hello"

                    echo "Copying latest code to EC2..."

                    scp -r -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        ./* \
                        ${SSH_USER}@13.234.74.131:/var/www/html/node-hello/

                    echo "Installing dependencies..."

                    ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no \
                        ${SSH_USER}@13.234.74.131 \
                        "cd /var/www/html/node-hello && npm install"

                    echo "Restarting application..."

                    ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no \
                        ${SSH_USER}@13.234.74.131 \
                        "cd /var/www/html/node-hello && pm2 restart node-hello || pm2 start /var/www/html/node-hello/index.js --name node-hello"

                    echo "Saving PM2 process list..."

                    ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no \
                        ${SSH_USER}@13.234.74.131 \
                        "pm2 save"

                    echo "DEPLOYMENT_SUCCESS"
                '''
            }
        }
    }
}

post {
    success {
        echo 'DEPLOYMENT SUCCESSFUL'
    }

    failure {
        echo 'DEPLOYMENT FAILED'
    }
}
```

}
